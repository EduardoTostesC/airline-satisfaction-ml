{
  "name": "xgboost_baseline",
  "hypothesis": "Comparar XGBoost aos demais modelos com folds idênticos.",
  "data_dir": "data/raw",
  "output_dir": "artifacts",
  "reports_dir": "reports/local",
  "registry": "reports/experiments.csv",
  "dataset_role": "competition",
  "id_column": "id",
  "target_column": "satisfaction",
  "target_mapping": null,
  "categorical_columns": null,
  "drop_columns": [],
  "seed": 2026,
  "n_splits": 5,
  "validation": "auto",
  "group_column": null,
  "model": "xgboost",
  "early_stopping_rounds": 100,
  "params": {
    "n_estimators": 2000,
    "learning_rate": 0.04,
    "max_depth": 6,
    "min_child_weight": 5,
    "reg_lambda": 3.0,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "tree_method": "hist",
    "device": "cpu",
    "n_jobs": 4,
    "objective": "binary:logistic",
    "eval_metric": "auc"
  },
  "folds_lock": "configs/folds-lock.json"
}
